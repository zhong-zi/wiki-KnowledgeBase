# ============================================================
# 服务器部署用环境变量（docker-compose.deploy.yml 通过 env_file 读取）
# 本文件会提交到私有仓库，里面就是这套系统能跑起来所需的全部配置。
# 换服务器时只需要改 APP_URL / APP_SECRET 两处，其余保持默认即可。
# ============================================================

# 对外访问地址：换成服务器 IP 或域名，例如 http://192.168.1.10:3000
APP_URL=http://localhost:3000
PORT=3000

# 会话加密密钥，泄漏等于可以伪造登录态，换服务器时建议重新生成：
#   openssl rand -hex 32
APP_SECRET=5b2c190c72d3ebdee17a22ecc99ef23de0e97e5b102572efffd9f0f46bfaaca9
JWT_TOKEN_EXPIRES_IN=30d

# 容器网络内部主机名，不要改成 localhost（那是容器自己）
DATABASE_URL=postgresql://postgres:docmost_db_2026@db:5432/docmost?schema=public
REDIS_URL=redis://redis:6379

STORAGE_DRIVER=local

# 许可证验签公钥：镜像内已内置 keys/license-public-key.pem
LICENSE_PUBLIC_KEY_PATH=/app/keys/license-public-key.pem

# AI：阿里云百炼（千问），OpenAI 兼容模式
AI_DRIVER=openai-compatible
OPENAI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-ws-H.RPYHLXY.nPSn.MEUCICDqdYq-mZHthUmmNm1JAYZeaLgG7kixPmA3vTueAkUXAiEAtXMrow_K7I_HLPj1Mp4PWA4iZVJHPX7IgFJC8jd1arQ
AI_COMPLETION_MODEL=qwen3.8-flash
AI_CHAT_MODEL=qwen3.8-flash
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSION=1024
AI_EMBEDDING_SUPPORTS_MRL=true
AI_VECTOR_DRIVER=pgvector
# 千问 embedding 单次最多 10 条，超过会 400，驱动已按该值自动分批
AI_EMBEDDING_BATCH_SIZE=10

# PDF 导出：compose 内的 gotenberg 服务名
GOTENBERG_URL=http://gotenberg:3000

# 邮件（可选，不配置就不发信，不影响使用）
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Docmost
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_SECURE=false
SMTP_IGNORETLS=false

DISABLE_TELEMETRY=true
